# ─── Email Provider ─────────────────────────────────────────────────────────
# Which provider to use. Currently supported: smtp
# To add a new provider, implement lib/email/providers/<name>.js and add a
# case in lib/email/mailer.js, then change this value.
EMAIL_PROVIDER=smtp

# ─── SMTP Settings (Hostinger) ───────────────────────────────────────────────
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@brixestimation.com
SMTP_PASS=your_email_password_here

# ─── Recipient ───────────────────────────────────────────────────────────────
# All quote form submissions will be forwarded to these addresses.
# Comma-separated for multiple recipients: email1@example.com,email2@example.com
CONTACT_RECIPIENT_EMAIL=hamzamfarooqi@gmail.com
